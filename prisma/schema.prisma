// DockMaster Service Writer prototype schema.
//
// Local dev runs on SQLite. The schema avoids SQLite-only and Postgres-only
// features (no enums, no native arrays, no Json columns) so that switching the
// datasource provider to "postgresql" is the only change needed for deployment.
// Array-like fields are stored as JSON-encoded strings and decoded in the
// DockMasterClient mock implementation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Marina {
  id              String @id @default(cuid())
  name            String
  city            String
  state           String
  laborRate       Float
  shopSuppliesPct Float
  taxPct          Float
}

model Technician {
  id             String          @id @default(cuid())
  name           String
  role           String // technician | lead_tech | service_manager
  skills         String // JSON string[]
  hourlyCost     Float
  availability   String // JSON { weekday: [[startHour, endHour]] }
  techNotes      TechNote[]
  workOrders     WorkOrder[]
  scheduleBlocks ScheduleBlock[]
  estimates      Estimate[]
}

model Customer {
  id            String     @id @default(cuid())
  name          String
  email         String
  phone         String
  portalEnabled Boolean    @default(true)
  arBalance     Float      @default(0)
  vessels       Vessel[]
  invoices      Invoice[]
  estimates     Estimate[]
}

model Vessel {
  id          String      @id @default(cuid())
  name        String
  make        String
  model       String
  year        Int
  lengthFt    Float
  hin         String      @unique
  engineMake  String
  engineModel String
  engineCount Int         @default(1)
  engineHours Int
  location    String // e.g. "Slip C-12" or "Rack B-07"
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  workOrders  WorkOrder[]
  estimates   Estimate[]
  techNotes   TechNote[]
}

model OperationCode {
  id                        String               @id @default(cuid())
  code                      String               @unique
  description               String
  category                  String
  standardHours             Float
  laborRate                 Float? // overrides Marina.laborRate when set
  keywords                  String // JSON string[]
  maintenanceIntervalMonths Int?
  kitId                     String?              @unique
  kit                       PartsKit?            @relation(fields: [kitId], references: [id])
  estimateLines             EstimateLine[]
  workOrderOperations       WorkOrderOperation[]
}

model PartsKit {
  id            String         @id @default(cuid())
  name          String
  items         KitItem[]
  operationCode OperationCode?
}

model KitItem {
  id     String   @id @default(cuid())
  kitId  String
  kit    PartsKit @relation(fields: [kitId], references: [id])
  partId String
  part   Part     @relation(fields: [partId], references: [id])
  qty    Float
}

model Part {
  id              String          @id @default(cuid())
  partNumber      String          @unique
  description     String
  vendor          String
  cost            Float
  sellPrice       Float
  onHand          Int
  reorderPoint    Int
  binLocation     String
  fitsEngineMakes String // JSON string[]
  kitItems        KitItem[]
  estimateLines   EstimateLine[]
  workOrderParts  WorkOrderPart[]
}

model WorkOrder {
  id             String               @id @default(cuid())
  number         String               @unique // WO-2024-0311
  vesselId       String
  vessel         Vessel               @relation(fields: [vesselId], references: [id])
  technicianId   String?
  technician     Technician?          @relation(fields: [technicianId], references: [id])
  status         String // open | scheduled | in_progress | closed
  description    String
  openedAt       DateTime
  closedAt       DateTime?
  hoursStandard  Float                @default(0)
  hoursBilled    Float                @default(0)
  total          Float                @default(0)
  estimateId     String?              @unique
  estimate       Estimate?            @relation(fields: [estimateId], references: [id])
  operations     WorkOrderOperation[]
  parts          WorkOrderPart[]
  scheduleBlocks ScheduleBlock[]
  invoices       Invoice[]
}

model WorkOrderOperation {
  id              String        @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id])
  operationCodeId String
  operationCode   OperationCode @relation(fields: [operationCodeId], references: [id])
  hours           Float
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  partId      String
  part        Part      @relation(fields: [partId], references: [id])
  qty         Float
}

model Estimate {
  id                      String         @id @default(cuid())
  number                  String         @unique // EST-2026-0142
  status                  String // draft_ai | draft_reviewed | awaiting_customer | approved | declined | converted
  title                   String
  vesselId                String
  vessel                  Vessel         @relation(fields: [vesselId], references: [id])
  customerId              String
  customer                Customer       @relation(fields: [customerId], references: [id])
  technicianId            String?
  technician              Technician?    @relation(fields: [technicianId], references: [id])
  techNoteId              String?
  techNote                TechNote?      @relation(fields: [techNoteId], references: [id])
  origin                  String         @default("tech_note") // tech_note | outreach | manual
  quoteSeparately         Boolean        @default(false)
  parentEstimateId        String?
  subtotalLabor           Float          @default(0)
  subtotalParts           Float          @default(0)
  shopSupplies            Float          @default(0)
  tax                     Float          @default(0)
  total                   Float          @default(0)
  requiresManagerApproval Boolean        @default(false)
  vesselMatchConfidence   Float?
  vesselMatchReasons      String         @default("[]") // JSON string[]
  historyFlags            String         @default("[]") // JSON HistoryFlag[]
  reasoning               String         @default("{}") // JSON ReasoningTrace
  customerSummary         String?
  internalSummary         String?
  photoPaths              String         @default("[]") // JSON string[]
  sentAt                  DateTime?
  approvedAt              DateTime?
  signedByName            String?
  signedAt                DateTime?
  declinedReason          String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  lines                   EstimateLine[]
  workOrder               WorkOrder?
}

model EstimateLine {
  id                  String         @id @default(cuid())
  estimateId          String
  estimate            Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  kind                String // operation | part | misc
  operationCodeId     String?
  operationCode       OperationCode? @relation(fields: [operationCodeId], references: [id])
  partId              String?
  part                Part?          @relation(fields: [partId], references: [id])
  parentLineId        String? // part lines hang off their operation line
  description         String
  customerDescription String?
  qty                 Float          @default(1)
  hours               Float?
  standardHours       Float?
  technicianHours     Float?
  hoursFlag           String? // e.g. "Technician estimate differs from standard by more than 50%"
  rate                Float?
  unitCost            Float?
  unitPrice           Float?
  lineTotal           Float          @default(0)
  included            Boolean        @default(true)
  confidence          Float?
  source              String         @default("ai") // ai | staff
  rationale           String?
  sourceNote          String?
  stockWarning        String?
  needsManagerReview  Boolean        @default(false)
  sortOrder           Int            @default(0)
}

model Invoice {
  id          String     @id @default(cuid())
  number      String     @unique // INV-2026-0412
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id])
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  amount      Float
  issuedAt    DateTime
  dueAt       DateTime
  paidAt      DateTime?
  description String
}

model TechNote {
  id           String     @id @default(cuid())
  transcript   String
  audioPath    String?
  photoPaths   String     @default("[]") // JSON string[]
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  vesselId     String?
  vessel       Vessel?    @relation(fields: [vesselId], references: [id])
  createdAt    DateTime   @default(now())
  estimates    Estimate[]
}

model ActivityLog {
  id         String   @id @default(cuid())
  actor      String // ai | staff | customer
  action     String
  entityType String
  entityId   String
  payload    String   @default("{}") // JSON
  createdAt  DateTime @default(now())
}

model ScheduleBlock {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])
  label        String
  start        DateTime
  end          DateTime
  source       String     @default("staff") // staff | ai_suggested
}

// ---------------------------------------------------------------------------
// Go-to-market workspace. These models stand in for the CRM (the agents' shared
// memory), the DockMaster data warehouse extract each account consented to,
// product telemetry, and the review queue where humans approve agent output.
// See src/lib/gtm/client.ts for the production mapping.
// ---------------------------------------------------------------------------

model Account {
  id                  String            @id @default(cuid())
  name                String
  city                String
  state               String
  segment             String // install_base | new_logo | group
  platform            String // dockmaster_desktop | dockmaster_web | dockmaster_web_mobile | molo | marinaoffice | spreadsheets | none
  products            String            @default("[]") // JSON string[]: web, mobile, valpay, blu, scheduling
  groupName           String?
  source              String            @default("seed") // seed | try_it | conference | partner
  stage               String            @default("target") // target | contacted | sandbox | call | proposal | closed_won | closed_lost | onboarding | live
  tier                String? // service_writer | ai_service_desk | revenue_suite | group
  ownerName           String? // CSM or AE who owns the relationship
  ownerRole           String? // CSM | AE
  designPartner       Boolean           @default(false)
  dataConsent         Boolean           @default(false)
  consentGrantedAt    DateTime?
  smsOptIn            Boolean           @default(false)
  emailOptOut         Boolean           @default(false)
  conferenceAttendees String            @default("[]") // JSON {name, title}[]
  contacts            String            @default("[]") // JSON Contact[] (from Researcher, approved)
  vesselMix           String            @default("[]") // JSON string[]: outboard | sterndrive | inboard | sail
  // Warehouse extract used by the Opportunity Scout when the account is not the
  // live Harbourline yard. Trailing-twelve-month figures as of DEMO_TODAY.
  technicianCount     Int               @default(0)
  slipCount           Int               @default(0)
  vesselCount         Int               @default(0)
  laborRate           Float             @default(0)
  standardHoursTtm    Float             @default(0)
  billedHoursTtm      Float             @default(0)
  estimatesTtm        Int               @default(0)
  estimatesOver3Days  Int               @default(0)
  avgEstimateValue    Float             @default(0)
  vesselsPastInterval Int               @default(0)
  avgIntervalJobValue Float             @default(0)
  arOver45            Float             @default(0)
  arTotal             Float             @default(0)
  dsoDays             Int               @default(0)
  contextFile         String            @default("")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  signals             AccountSignal[]
  codes               AccountCode[]
  weeks               AccountWeek[]
  runs                AgentRun[]
  queueItems          QueueItem[]
  messages            OutboundMessage[]
  feedback            FeedbackItem[]
}

// Raw public signals the Account Researcher classifies. In production these
// arrive from web search, review sites and LinkedIn through MCP tools.
model AccountSignal {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  source     String // linkedin | google_reviews | job_posting | website | boat_show | association | news | capterra
  title      String
  body       String
  url        String?
  observedAt DateTime
}

// An account's own operation codes as exported from their system, before the
// Onboarding Agent cleans them.
model AccountCode {
  id          String  @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  code        String
  description String
  hours       Float
  usageCount  Int     @default(0)
  mergedInto  String?
}

// Weekly product telemetry for accounts on the beta or live.
model AccountWeek {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  weekStart      DateTime
  draftsStarted  Int
  draftsApproved Int
  editRate       Float // share of AI lines edited before approval
  approvalRate   Float // approved / sent to customer
  valpayVolume   Float
  arDays         Int
  activeTechs    Int
}

// Support tickets, call snippets, conference dot-votes, reviews.
model FeedbackItem {
  id         String   @id @default(cuid())
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id])
  source     String // support_ticket | call_transcript | dot_vote | review
  text       String
  observedAt DateTime
}

model Partner {
  id       String @id @default(cuid())
  name     String
  kind     String // oem | distributor | insurer | pe_operating_partner | association
  focus    String
  contacts String @default("[]") // JSON {name, title}[]
  notes    String @default("")
}

// Every agent action, with inputs and outputs, written back to the CRM.
model AgentRun {
  id            String     @id @default(cuid())
  agent         String
  accountId     String?
  account       Account?   @relation(fields: [accountId], references: [id])
  status        String // succeeded | failed | blocked
  input         String     @default("{}") // JSON
  output        String     @default("{}") // JSON
  sourceQueries String     @default("[]") // JSON SourceQuery[]: where every number came from
  model         String?
  modelTier     String? // none | cheap | strong
  latencyMs     Int        @default(0)
  error         String?
  createdAt     DateTime   @default(now())
  queueItems    QueueItem[]
}

// The review queue. Every agent output lands here for a named human.
model QueueItem {
  id           String            @id @default(cuid())
  runId        String?
  run          AgentRun?         @relation(fields: [runId], references: [id])
  agent        String
  kind         String // scout_report | research | sequence | sandbox | try_it_lead | rfp_answer | proposal | call_notes | onboarding_plan | health_report | case_study | voc_report | conference_plan | partner_brief
  accountId    String?
  account      Account?          @relation(fields: [accountId], references: [id])
  title        String
  output       String            @default("{}") // JSON, the agent's draft
  sourceData   String            @default("{}") // JSON, what the agent saw
  approverRole String
  status       String            @default("pending") // pending | approved | edited | rejected
  reviewerName String?
  reviewedAt   DateTime?
  editedOutput String? // JSON, the human's version when status is edited
  editRatio    Float? // characters changed / characters drafted
  reviewNote   String?
  createdAt    DateTime          @default(now())
  messages     OutboundMessage[]
}

// Outbound touches. Only created by a human click on an approved sequence.
model OutboundMessage {
  id          String     @id @default(cuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id])
  queueItemId String?
  queueItem   QueueItem? @relation(fields: [queueItemId], references: [id])
  touchIndex  Int        @default(0)
  channel     String // email | sms | linkedin | call
  subject     String?
  body        String
  approvedBy  String
  sentAt      DateTime
  status      String     @default("sent") // sent | replied | bounced | opted_out
  repliedAt   DateTime?
}
