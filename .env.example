# Local dev uses SQLite. Deployment swaps the datasource provider to Postgres
# (see scripts/vercel-build.sh) and points DATABASE_URL at a Postgres URL.
DATABASE_URL="file:./dev.db"

# Required for drafting estimates, outreach and reminders.
ANTHROPIC_API_KEY=""

# Optional. If absent, transcription falls back to paste mode with a visible notice.
OPENAI_API_KEY=""
